{
  "cli": {
    "version": ">= 16.13.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Debug"
      },
      "env": {
        "SKIP_BUNDLING": "0"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Release",
        "image": "latest"
      },
      "env": {
        "SKIP_BUNDLING": "0"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release",
        "image": "latest"
      },
      "env": {
        "SKIP_BUNDLING": "0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
